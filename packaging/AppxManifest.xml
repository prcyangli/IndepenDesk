<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <Identity Name="harungecit.IndepenDesk"
            Publisher="CN=harungecit"
            Version="{VERSION4}"
            ProcessorArchitecture="{ARCH}" />

  <Properties>
    <DisplayName>IndepenDesk</DisplayName>
    <PublisherDisplayName>harungecit</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="IndepenDesk" Executable="IndepenDesk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="IndepenDesk"
                          Description="Independent virtual desktops per monitor for Windows"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask"
                           Executable="IndepenDesk.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="IndepenDeskStartup"
                               Enabled="true"
                               DisplayName="IndepenDesk" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
