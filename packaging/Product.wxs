<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="IndepenDesk"
           Manufacturer="harungecit"
           Version="$(var.MyVersion)"
           Language="1033"
           UpgradeCode="7E4B1D6A-9C2F-4E83-B5A1-2D3C4E5F6071"
           Scope="perMachine">

    <SummaryInformation Description="Independent virtual desktops per monitor for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of IndepenDesk is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/harungecit/IndepenDesk" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="IndepenDesk">
        <Component Id="MainExecutable">
          <File Id="IndepenDeskExe" Source="$(var.ExePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="IndepenDesk"
                  Target="[INSTALLFOLDER]IndepenDesk.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\harungecit\IndepenDesk"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- Başlangıç: uygulamanın da yönettiği HKCU Run değeri (kaldırırken silinir) -->
      <Component Id="StartupRegistryValue">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="IndepenDesk" Type="string"
                       Value="&quot;[INSTALLFOLDER]IndepenDesk.exe&quot;" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupRegistryValue" />
    </Feature>
  </Package>
</Wix>
